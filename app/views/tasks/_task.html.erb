<div id="<%= dom_id task %>" class="task-item">
  <div class="task-row">
    <strong style="margin: 10px 0px;">
      <%= link_to task.title, edit_task_path(task), class: "task-link" %>
    </strong>

    <% if task.status == "pending" %>
    <span style="color: orange;"><%= task.status %></span>
    <span> <%= button_to "Start", update_status_task_path(task), method: :patch,
     data: { turbo: true } %> </span>

    <% elsif task.status == "in-progress" %>
    <span style="color: blue;"><%= task.status %></span>
    <span> <%= button_to "Finish", update_status_task_path(task), method: :patch,
     data: { turbo: true } %> </span>
    
    <% elsif task.status == "Done" %>
    <span style="color: green;"><%= task.status %></span>
    <span> <%= button_to "Delete", task, method: :delete %> </span>

    <% end %>

    
  </div>
</div>
