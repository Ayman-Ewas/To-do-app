<div id="<%= dom_id task %>" class="task-item">
  <div class="task-row">
    <%= button_to " ", task, method: :delete, class: "task-checkbox" %>
    <strong style="margin: 10px 0px;">
      <%= link_to task.title, edit_task_path(task), class: "task-link" %>
    </strong>

    <% if task.status == "pending" %>
    <span style="color: orange;"><%= task.status%></span>

    <% elsif task.status == "in_progress" %>
    <span style="color: blue;"><%= task.status%></span>

    <% elsif task.status == "completed" %>
    <span style="color: green;"><%= task.status%></span>

    <% end %>
    <%= button_to "Start", update_task_status_path(task), method: :patch, data: { turbo: true } %>
  </div>
</div>
