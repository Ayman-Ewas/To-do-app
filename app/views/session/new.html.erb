<h1>Log In</h1>

<%= form_for(:user, url: login_path, method: :post) do |form| %>
  <div>
    <%= form.label :Email %>
    <%= form.email_field :email, required: true %>
  </div>

  <div>
    <%= form.label :Password %>
    <%= form.password_field :password, required: true %>
  </div>

  <div>
    <%= form.submit "Log In"%>
  </div>

  <div> Don't have an account? <%= link_to "Sign Up", signup_path%></div>
<% end %>